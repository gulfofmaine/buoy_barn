REDIS_CACHE=redis://buoy-barn-cache:6379/
CELERY_BROKER_URL=redis://buoy-barn-cache:6379/1
OTEL_SERVICE_NAME=buoy-barn
# Existing in-cluster OTLP collector. Unset this and all metrics become a no-op.
# Its pipeline must accept OTLP *metrics*, not just traces -- see
# docs/observability-deployment.md.
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector.observability:4318
