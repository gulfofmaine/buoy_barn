REDIS_CACHE=redis://buoy-barn-cache:6379/
CELERY_BROKER_URL=redis://buoy-barn-cache:6379/1
OTEL_SERVICE_NAME=buoy-barn
# Deliberately left unset here, and set by the overlay instead. Unset is the only value
# that is genuinely a no-op: an endpoint that is set but unreachable makes the SDK retry
# and log an export failure on every interval, in every process, forever. The overlay
# supplies the cluster's real collector -- see docs/observability-deployment.md.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector.observability:4318
# Optional Grafana Explore deep links on SystemMessages -- PromQL is always shown without
# these, so leave commented out until Grafana is actually deployed for this project.
# GRAFANA_BASE_URL=https://grafana.example.org
# GRAFANA_PROMETHEUS_UID=prometheus
